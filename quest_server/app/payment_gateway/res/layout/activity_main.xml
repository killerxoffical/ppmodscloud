<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#070c14">

    <!-- Top Navigation Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_header"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <ImageView
            android:id="@+id/imgNavLogo"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@drawable/ic_launcher"
            android:contentDescription="Logo" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PP AUTO GATEWAY"
                android:textColor="#ffffff"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtStatusHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Live SMS Payment Bridge"
                android:textColor="#10b981"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnRefresh"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_refresh"
            android:background="@drawable/btn_icon_dark"
            android:contentDescription="Refresh"
            android:padding="8dp" />
    </LinearLayout>

    <!-- Main Scroll Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/topBar"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Hero Status Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_emerald"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_shield"
                        android:contentDescription="Status" />

                    <TextView
                        android:id="@+id/txtHeroTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="GATEWAY ACTIVE"
                        android:textColor="#10b981"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <!-- Service Toggle Button -->
                    <Button
                        android:id="@+id/btnToggleService"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:text="Running"
                        android:textColor="#ffffff"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:background="@drawable/badge_pill_green"
                        android:paddingHorizontal="12dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="24/7 Automated bKash, Nagad &amp; Rocket deposit verification on Cloudflare D1."
                    android:textColor="#cbd5e1"
                    android:textSize="12sp" />

                <!-- Statistics Bar -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="14dp"
                    android:paddingTop="12dp"
                    android:background="#15000000">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Forwarded"
                            android:textColor="#64748b"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/txtStatForwarded"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="#ffffff"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Auto Approved"
                            android:textColor="#64748b"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/txtStatApproved"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="#10b981"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.2"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Total Amount"
                            android:textColor="#64748b"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/txtStatAmount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="৳ 0"
                            android:textColor="#38bdf8"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Quick Action Tools Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <Button
                    android:id="@+id/btnTestSms"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="Test bKash SMS"
                    android:textColor="#ffffff"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="@drawable/btn_primary_blue"
                    android:drawableStart="@drawable/ic_test"
                    android:drawablePadding="6dp"
                    android:paddingHorizontal="10dp"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/btnScanInbox"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="Scan Recent SMS"
                    android:textColor="#ffffff"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="@drawable/btn_primary_emerald"
                    android:drawableStart="@drawable/ic_sms"
                    android:drawablePadding="6dp"
                    android:paddingHorizontal="10dp" />
            </LinearLayout>

            <!-- Server Settings Box (Collapsible/Editable) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_sms"
                android:padding="14dp"
                android:layout_marginBottom="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_settings"
                        android:contentDescription="Settings" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Gateway Configuration"
                        android:textColor="#ffffff"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <EditText
                    android:id="@+id/editServerUrl"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:hint="Primary Server URL"
                    android:textColor="#ffffff"
                    android:textColorHint="#64748b"
                    android:textSize="12sp"
                    android:singleLine="true"
                    android:background="#0b111c"
                    android:paddingHorizontal="10dp"
                    android:layout_marginTop="10dp" />

                <EditText
                    android:id="@+id/editSecretKey"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:hint="Gateway Secret Key"
                    android:textColor="#ffffff"
                    android:textColorHint="#64748b"
                    android:textSize="12sp"
                    android:singleLine="true"
                    android:background="#0b111c"
                    android:paddingHorizontal="10dp"
                    android:layout_marginTop="8dp" />

                <Button
                    android:id="@+id/btnSaveConfig"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Save Settings"
                    android:textColor="#ffffff"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="@drawable/btn_primary_blue"
                    android:paddingHorizontal="16dp"
                    android:layout_gravity="end"
                    android:layout_marginTop="10dp" />
            </LinearLayout>

            <!-- Section Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="LIVE TRANSACTIONS"
                    android:textColor="#64748b"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Real-Time Feed"
                    android:textColor="#10b981"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Empty State Card -->
            <LinearLayout
                android:id="@+id/layoutEmptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_card_sms"
                android:padding="26dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_sms"
                    android:contentDescription="Empty"
                    android:alpha="0.4" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="No Payment SMS Detected Yet"
                    android:textColor="#cbd5e1"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="When a customer pays via bKash, Nagad or Rocket, the payment will be automatically parsed, verified and approved here."
                    android:textColor="#64748b"
                    android:textSize="12sp"
                    android:gravity="center" />
            </LinearLayout>

            <!-- Live Transaction Cards Container -->
            <LinearLayout
                android:id="@+id/smsFeedContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>
    </ScrollView>

</RelativeLayout>
